---
import { getCollection, render } from "astro:content";
import DocsLayout from "~/layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter((d) => d.id !== "index" && d.id !== "index.mdx")
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.mdx?$/, "") },
      props: { entry, docs },
    }));
}

const { entry, docs } = Astro.props;
const { Content } = await render(entry);

const docsNav = docs
  .filter((d) => d.id !== "index" && d.id !== "index.mdx")
  .map((d) => ({
    href: `/docs/${d.id.replace(/\.mdx?$/, "")}/`,
    title: d.data.title,
    order: d.data.order ?? 0,
    section: d.data.section as string | undefined,
  }));
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  docsNav={docsNav}
>
  <header class="mb-8">
    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-ink-500">
      {entry.data.section}
    </p>
    <h1 class="font-display text-4xl tracking-tight text-ink-900">
      {entry.data.title}
    </h1>
    {entry.data.description && (
      <p class="mt-3 text-lg text-ink-600">{entry.data.description}</p>
    )}
  </header>

  <Content />

  <footer class="mt-16 border-t border-paper-300 pt-6 text-sm text-ink-500">
    <a
      href={`https://github.com/opencdd/opencdd-ruby/edit/main/docs/src/content/docs/${entry.id.replace(/^.*\//, "")}`}
      target="_blank"
      rel="noreferrer noopener"
      class="text-hex-700 hover:text-hex-600"
    >
      Edit this page on GitHub →
    </a>
  </footer>
</DocsLayout>
