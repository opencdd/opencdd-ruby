# =============================================================================
# Powertype — AntiqueCategory (kind-of-object dimension)
#
# Each member is an EXTENDED INSTANCE: selectable as the value of the
# `category` CLASS_REFERENCE property AND a class in its own right that
# owns the properties specific to that kind of object.
#
#   AntiqueCategory (CATEGORICAL_CLASS)
#   ├── Ceramics            ⇒ kiln, glaze           (+ conditional reign_mark)
#   ├── Bronze              ⇒ vessel_form, inscription_characters
#   ├── Jade                ⇒ jade_stone
#   ├── PaintingCalligraphy ⇒ medium, mounting_format
#   ├── Furniture           ⇒ wood_type
#   ├── Lacquer             ⇒ lacquer_technique
#   ├── CloisonneEnamel     ⇒ cloisonne_technique
#   ├── BuddhistSculpture   ⇒ sculpture_material
#   ├── SnuffBottle         ⇒ bottle_material
#   └── UkiyoEPrint         ⇒ print_format
# =============================================================================

instance AntiqueCategory < MDC_C002 {
  code: ANA100
  preferred_name.en: "Antique Category"
  preferred_name.zh-Hant: "品類"
  definition.en: "categorical class whose members enumerate the kinds of East Asian works of art"
  superclass: Antique
  class_type: CATEGORICAL_CLASS
}

instance Ceramics < MDC_C002 {
  code: ANA101
  preferred_name.en: "Ceramics"
  preferred_name.zh-Hant: "陶瓷"
  preferred_name.ja: "陶磁器"
  definition.en: "objects of fired clay, including porcelain and stoneware vessels and wares"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { kiln, glaze }
}

instance Bronze < MDC_C002 {
  code: ANA102
  preferred_name.en: "Bronze"
  preferred_name.zh-Hant: "青銅器"
  definition.en: "cast bronze ritual vessels, weapons and fittings"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { vessel_form, inscription_characters }
}

instance Jade < MDC_C002 {
  code: ANA103
  preferred_name.en: "Jade"
  preferred_name.zh-Hant: "玉器"
  definition.en: "objects carved from jade stone, whether nephrite or jadeite"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { jade_stone }
}

instance PaintingCalligraphy < MDC_C002 {
  code: ANA104
  preferred_name.en: "Painting and Calligraphy"
  preferred_name.zh-Hant: "書畫"
  preferred_name.ja: "書画"
  definition.en: "paintings and works of calligraphy on paper or silk"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { medium, mounting_format }
}

instance Furniture < MDC_C002 {
  code: ANA105
  preferred_name.en: "Furniture"
  preferred_name.zh-Hant: "家具"
  definition.en: "cabinetwork and household furniture of hardwood or softwood"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { wood_type }
}

instance Lacquer < MDC_C002 {
  code: ANA106
  preferred_name.en: "Lacquer"
  preferred_name.zh-Hant: "漆器"
  preferred_name.ja: "漆工"
  definition.en: "objects decorated or built in applied lacquer"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { lacquer_technique }
}

instance CloisonneEnamel < MDC_C002 {
  code: ANA107
  preferred_name.en: "Cloisonné Enamel"
  preferred_name.zh-Hant: "掐絲琺瑯"
  definition.en: "objects decorated with cloisonné enamel, wire-outlined glass paste fired on a metal body"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { cloisonne_technique }
}

instance BuddhistSculpture < MDC_C002 {
  code: ANA108
  preferred_name.en: "Buddhist Sculpture"
  preferred_name.zh-Hant: "佛教造像"
  definition.en: "sculptural images of Buddhist devotion"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { sculpture_material }
}

instance SnuffBottle < MDC_C002 {
  code: ANA109
  preferred_name.en: "Snuff Bottle"
  preferred_name.zh-Hant: "鼻煙壺"
  definition.en: "small bottle for powdered tobacco, made in glass, porcelain, jade and other materials"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { bottle_material }
}

instance UkiyoEPrint < MDC_C002 {
  code: ANA110
  preferred_name.en: "Ukiyo-e Print"
  preferred_name.zh-Hant: "浮世繪"
  preferred_name.ja: "浮世絵"
  definition.en: "Japanese woodblock print of the floating-world genre"
  superclass: AntiqueCategory
  class_type: ITEM_CLASS
  applicable_properties: { print_format }
}

# =============================================================================
# Enumerations
# =============================================================================

instance vessel_form_enum < MDC_C005 {
  code: ANE001
  preferred_name.en: "vessel form categories"
  definition.en: "enumeration of classical Chinese ritual vessel forms"
  enumerated_values: { Ding, Gui, Jue, Hu, Zun }
}

instance jade_stone_enum < MDC_C005 {
  code: ANE002
  preferred_name.en: "jade stone categories"
  definition.en: "enumeration of the jade minerals"
  enumerated_values: { Nephrite, Jadeite }
}

instance medium_enum < MDC_C005 {
  code: ANE003
  preferred_name.en: "medium categories"
  definition.en: "enumeration of painting and calligraphy media"
  enumerated_values: { Ink_on_paper, Ink_on_silk, Ink_and_colour_on_paper, Ink_and_colour_on_silk }
}

instance mounting_enum < MDC_C005 {
  code: ANE004
  preferred_name.en: "mounting format categories"
  definition.en: "enumeration of traditional East Asian mounting formats"
  enumerated_values: { Handscroll, Hanging_scroll, Album_leaf, Fan }
}

instance sculpture_material_enum < MDC_C005 {
  code: ANE005
  preferred_name.en: "sculpture material categories"
  definition.en: "enumeration of sculptural materials of Buddhist images"
  enumerated_values: { Wood, Bronze, Gilt_bronze, Stone }
}

instance print_format_enum < MDC_C005 {
  code: ANE006
  preferred_name.en: "print format categories"
  definition.en: "enumeration of Japanese woodblock print sheet formats"
  enumerated_values: { Oban, Chuban, Aiban, Kakemono_e }
}

instance condition_enum < MDC_C005 {
  code: ANE007
  preferred_name.en: "condition grade categories"
  definition.en: "enumeration of preservation condition grades used in cataloguing"
  enumerated_values: { Excellent, Very_good, Good, Fair }
}

# =============================================================================
# Core properties (defined on Antique)
# =============================================================================

instance category < MDC_C003 {
  code: ANB001
  preferred_name.en: "antique category"
  preferred_name.zh-Hant: "品類"
  definition.en: "kind of object, selected from the antique category classification"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: CLASS_REFERENCE(AntiqueCategory)
}

instance culture < MDC_C003 {
  code: ANB002
  preferred_name.en: "culture"
  preferred_name.zh-Hant: "文化"
  definition.en: "cultural sphere of origin of the antique"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: CLASS_REFERENCE(Culture)
}

instance period < MDC_C003 {
  code: ANB003
  preferred_name.en: "period"
  preferred_name.zh-Hant: "朝代時期"
  definition.en: "dynasty or era of the antique"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: CLASS_REFERENCE(Period)
}

instance height < MDC_C003 {
  code: ANB004
  preferred_name.en: "height"
  preferred_name.zh-Hant: "高度"
  definition.en: "height of the object as catalogued"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: REAL_TYPE
  unit: centimetre
}

instance diameter < MDC_C003 {
  code: ANB005
  preferred_name.en: "diameter"
  preferred_name.zh-Hant: "口徑"
  definition.en: "diameter of the widest body section, as catalogued"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: REAL_TYPE
  unit: centimetre
}

instance condition_grade < MDC_C003 {
  code: ANB006
  preferred_name.en: "condition grade"
  preferred_name.zh-Hant: "品相"
  definition.en: "preservation condition of the object"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Antique
  data_type: ENUM_STRING_TYPE(condition_enum)
}

# Conditional attribution — the "Mark and Period" pattern: a reign mark is
# catalogued only for objects whose category selects Ceramics.
instance reign_mark < MDC_C003 {
  code: ANB007
  preferred_name.en: "reign mark"
  preferred_name.zh-Hant: "年款"
  definition.en: "imperial reign mark inscribed on the object"
  property_data_element_type: CONDITION_DET
  definition_class: Antique
  data_type: STRING_TYPE
  condition: category == Ceramics
}

# =============================================================================
# Category-specific properties — defined ON the extended instances
#
# These properties exist only because their definition_class is an instance
# of a CATEGORICAL_CLASS: an instance that owns class-level facts.
# =============================================================================

instance kiln < MDC_C003 {
  code: ANB101
  preferred_name.en: "kiln"
  preferred_name.zh-Hant: "窯口"
  definition.en: "kiln complex or firing centre of origin"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Ceramics
  data_type: STRING_TYPE
}

instance glaze < MDC_C003 {
  code: ANB102
  preferred_name.en: "glaze"
  preferred_name.zh-Hant: "釉彩"
  definition.en: "glaze and dominant decorative palette of the ware"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Ceramics
  data_type: STRING_TYPE
}

instance vessel_form < MDC_C003 {
  code: ANB103
  preferred_name.en: "vessel form"
  preferred_name.zh-Hant: "器形"
  definition.en: "classical ritual vessel form of the bronze"
  property_data_element_type: NON_DEPENDENT_P_DET
