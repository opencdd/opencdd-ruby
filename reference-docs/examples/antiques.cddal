}

instance medium < MDC_C003 {
  code: ANB106
  preferred_name.en: "medium"
  preferred_name.zh-Hant: "材質"
  definition.en: "ink and colour medium on the paper or silk support"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: PaintingCalligraphy
  data_type: ENUM_STRING_TYPE(medium_enum)
}

instance mounting_format < MDC_C003 {
  code: ANB107
  preferred_name.en: "mounting format"
  preferred_name.zh-Hant: "裝裱形式"
  definition.en: "traditional mounting format of the work"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: PaintingCalligraphy
  data_type: ENUM_STRING_TYPE(mounting_enum)
}

instance wood_type < MDC_C003 {
  code: ANB108
  preferred_name.en: "wood type"
  preferred_name.zh-Hant: "木料"
  definition.en: "timber of the furniture"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Furniture
  data_type: STRING_TYPE
}

instance lacquer_technique < MDC_C003 {
  code: ANB109
  preferred_name.en: "lacquer technique"
  preferred_name.zh-Hant: "漆藝"
  definition.en: "decorative lacquer technique of the object"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: Lacquer
  data_type: STRING_TYPE
}

instance cloisonne_technique < MDC_C003 {
  code: ANB110
  preferred_name.en: "cloisonné technique"
  preferred_name.zh-Hant: "琺瑯工藝"
  definition.en: "enamel technique applied to the metal body"
  property_data_element_type: NON_DEPENDENT_P_DET
