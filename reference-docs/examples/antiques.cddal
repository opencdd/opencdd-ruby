instance sculpture_material < MDC_C003 {
  code: ANB111
  preferred_name.en: "sculpture material"
  preferred_name.zh-Hant: "造像材質"
  definition.en: "material of the sculptural image"
  property_data_element_type: NON_DEPENDENT_P_DET
