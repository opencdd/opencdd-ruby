# =============================================================================
# East Asian Antiques 東方古董 — CDD worked example
#
# An auction-house-style reference dictionary for East Asian works of art,
# authored by OpenCDD from standard art-historical vocabulary. Demonstrates:
#
#   * Three stacked classification dimensions as powertypes:
#       AntiqueCategory (kind of object), Period (dynasty/era),
#       Culture (country of origin)
#   * Extended instances: each AntiqueCategory member is an instance
#     selectable via the `category` property AND a class owning its own
#     applicable_properties (e.g. Ceramics ⇒ kiln, glaze)
#   * CONDITION_DET conditional property at the root: `reign_mark` applies
#     only when category == Ceramics (the "Mark and Period" attribution
#     of the auction world)
#   * Configured subclasses via sub_class_selection:
#       Ceramics × Ming   ⇒ MingBlueAndWhite
#       Ceramics × Goryeo ⇒ GoryeoCeladon
#     (instance-of-instance used as a class)
#   * Registered individuals: well-known museum objects as leaf entities
#     with native multilingual names (zh-Hant, ja, ko) and English
#
# Reference basis for the category vocabulary (kept in the private repo):
# public department listings of international auction houses, used as
# reference only. All names, definitions and structure are our own.
#
# Code allocation (OpenCDD house convention):
#   <stem><T><NNN> — stem is unique per dictionary, T is the entity type:
#   A class · B property · E value list · T value term · I individual · U unit
#   AN = antiques: ANA classes (incl. powertype members and configured
#   subclasses), ANB properties, ANE enumerations, ANI museum objects.
#   Blocks: 0xx culture · 02x period · 1xx object categories · 15x
#   configured subclasses.
# =============================================================================

import "https://cdd.opencdd.org/dictionaries/rec20-units.cddal"

# -----------------------------------------------------------------------------
# Aliases (re-declare built-ins for reader clarity)
# -----------------------------------------------------------------------------

alias code:                        MDC_P001_5
alias preferred_name:              MDC_P004
alias short_name:                  MDC_P005
alias definition:                  MDC_P006
alias note:                        MDC_P008
alias remark:                      MDC_P009
alias superclass:                  MDC_P010
alias class_type:                  MDC_P011
alias is_case_of:                  MDC_P013
alias applicable_properties:       MDC_P014
alias property_data_element_type:  MDC_P020
alias definition_class:            MDC_P021
alias data_type:                   MDC_P022
alias unit:                        MDC_P041
alias condition:                   MDC_P028
alias sub_class_selection:         MDC_P016
alias enumerated_values:           MDC_P044

# -----------------------------------------------------------------------------
# Meta-class schema
# -----------------------------------------------------------------------------

meta-class MDC_C002 {
  code
  preferred_name
  short_name
  definition
  note
  remark
  synonym
  superclass
  class_type
  is_case_of
  applicable_properties
  sub_class_selection
  imported_properties
}

meta-class MDC_C003 {
  code
  preferred_name
  short_name
  definition
  note
  remark
  property_data_element_type
  definition_class
  data_type
  unit
  condition
}

meta-class MDC_C005 {
  code
  preferred_name
  definition
  note
  remark
  enumerated_values
}

# =============================================================================
# Core categorical class: Antique
# =============================================================================

instance Antique < MDC_C002 {
  code: ANA001
  preferred_name.en: "Antique"
  preferred_name.zh-Hant: "古董"
  preferred_name.ja: "骨董"
  preferred_name.ko: "골동품"
  definition.en: "object of art or craftsmanship from a past period, valued for its age, beauty, rarity, or provenance"
  superclass: UNIVERSE
  class_type: ITEM_CLASS
  applicable_properties: { category, culture, period, height, diameter, condition_grade }
}

# =============================================================================
# Culture — plain instances (origin dimension)
# =============================================================================

instance Culture < MDC_C002 {
  code: ANA010
  preferred_name.en: "Culture"
  preferred_name.zh-Hant: "文化"
  definition.en: "cultural sphere of origin of an antique"
  superclass: Antique
  class_type: CATEGORICAL_CLASS
}

instance China < MDC_C002 {
  code: ANA011
  preferred_name.en: "China"
  preferred_name.zh-Hant: "中國"
  definition.en: "Chinese cultural sphere of origin"
  superclass: Culture
  class_type: ITEM_CLASS
}

instance Japan < MDC_C002 {
  code: ANA012
  preferred_name.en: "Japan"
  preferred_name.ja: "日本"
  definition.en: "Japanese cultural sphere of origin"
  superclass: Culture
  class_type: ITEM_CLASS
}

instance Korea < MDC_C002 {
  code: ANA013
  preferred_name.en: "Korea"
  preferred_name.ko: "한국"
  definition.en: "Korean cultural sphere of origin"
  superclass: Culture
  class_type: ITEM_CLASS
}

# =============================================================================
# Powertype — Period (dynasty / era dimension)
#
# The second classification axis: the same object category exists in many
# periods, and a period is a value of the `period` property, not a subclass
# of the object tree.
# =============================================================================

instance Period < MDC_C002 {
  code: ANA020
  preferred_name.en: "Period"
  preferred_name.zh-Hant: "朝代時期"
  definition.en: "categorical class whose members enumerate the dynasties and eras of East Asian art history"
  superclass: Antique
  class_type: CATEGORICAL_CLASS
}

